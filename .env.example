# Copy to .env.local and fill in from the Supabase dashboard (Project Settings > API).
# Never commit real values. The anon key is public-by-design but still stays out of git;
# the service-role key must NEVER be in the app or any EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
