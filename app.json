{
  "expo": {
    "name": "Splitty",
    "slug": "splitty",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "splitty",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.tenkodigital.splitty",
      "infoPlist": {
        "NSCameraUsageDescription": "Splitty uses the camera to scan receipts.",
        "NSPhotoLibraryUsageDescription": "Splitty lets you attach receipt photos from your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F9D74",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tenkodigital.splitty",
      "versionCode": 4,
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F9D74",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Splitty lets you attach receipt photos from your library.",
          "cameraPermission": "Splitty uses the camera to scan receipts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/app"
    },
    "description": "Split bills with friends. Local-first, no account, receipt scanning."
  }
}
